# ── LA Space Studio API — environment ────────────────────────────────────
# Copy to .env and fill in. .env is git-ignored; never commit real values.

NODE_ENV=development
PORT=4000

# Public origins allowed by CORS. Same-origin /api in production makes
# these the site itself; in dev they are the two Vite servers.
PUBLIC_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# ── Database ─────────────────────────────────────────────────────────────
# Two users, per the security plan: the app can only read and write rows;
# only the migrate user may change the schema. scripts/db-bootstrap.sh
# creates both from these values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=laspace
DB_APP_USER=laspace_app
DB_APP_PASSWORD=change-me
DB_MIGRATE_USER=laspace_migrate
DB_MIGRATE_PASSWORD=change-me-too

# Prisma reads DATABASE_URL. The deploy step swaps in MIGRATE_DATABASE_URL
# for `prisma migrate deploy`, so the running app never holds DDL rights.
DATABASE_URL=mysql://laspace_app:change-me@127.0.0.1:3306/laspace
MIGRATE_DATABASE_URL=mysql://laspace_migrate:change-me-too@127.0.0.1:3306/laspace

# ── Sessions ─────────────────────────────────────────────────────────────
SESSION_TTL_DAYS=30

# ── Enquiry alerts (Nodemailer over SMTP) ─────────────────────────────────
# Any mailbox with SMTP access: a Gmail app password, or the hosting plan's
# mail server. ALERT_TO is the studio inbox that receives new enquiries.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM="LA Space Website <no-reply@laspaceinteriors.com>"
ALERT_TO=

# ── Media ────────────────────────────────────────────────────────────────
# local  = files under MEDIA_LOCAL_PATH, served by the API (dev only)
# s3     = any S3-compatible bucket behind a CDN (staging, production)
MEDIA_DRIVER=local
MEDIA_LOCAL_PATH=./storage
MEDIA_MAX_UPLOAD_MB=40
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=
