# ── LA Space website — environment ───────────────────────────────────────
# Copy to .env and adjust. .env is git-ignored; this file is the template.
#
# Vite rules: only VITE_-prefixed variables reach browser code
# (import.meta.env.VITE_*), and they are baked in at build time — change one,
# rebuild. Per-mode files are read too: .env.development on `npm run dev`,
# .env.production on `npm run build`. .env.local overrides and is ignored.

# ── Dev server ───────────────────────────────────────────────────────────
VITE_DEV_PORT=5173
# Where the dev server forwards /api and /media. Dev only — in production the
# studio API serves the site itself, so both are same-origin.
VITE_API_PROXY_TARGET=http://localhost:4000

# ── API ──────────────────────────────────────────────────────────────────
# Where the browser sends API calls (the two enquiry forms). Same-origin /api
# by default. Set an absolute origin only if the API is deployed on its own
# host, e.g. https://api.laspaceinteriors.in/api — and allow this site in
# the API's CORS (PUBLIC_ORIGIN in its .env).
VITE_API_BASE=/api

# ── Site ─────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Feeds `site.url` and the site-data.json
# the API reads for structured data. Each page's <head> canonical is per file.
VITE_SITE_URL=https://www.laspaceinteriors.in

# Analytics and Search Console verification are injected by the API from its
# own .env (GA4_MEASUREMENT_ID, GOOGLE_SITE_VERIFICATION) — nothing here.
