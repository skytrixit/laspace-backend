# ── LA Space Studio API — environment ────────────────────────────────────
# Copy to .env and fill in. .env is git-ignored; never commit real values.

NODE_ENV=development
PORT=4000

# Public origins allowed by CORS. Same-origin /api in production makes
# these the site itself; in dev they are the two Vite servers.
PUBLIC_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# ── Database ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=laspace
DB_USERNAME=laspace_app
DB_PASSWORD=change-me

# Schema changes (migrations) run as this second user, which may alter
# tables. The API itself never uses it. Leave both blank to use one user.
DB_MIGRATE_USERNAME=laspace_migrate
DB_MIGRATE_PASSWORD=change-me-too

# ── Sessions ─────────────────────────────────────────────────────────────
SESSION_TTL_DAYS=30

# true only behind a reverse proxy (nginx etc.) that sets X-Forwarded-For.
TRUST_PROXY=false

# ── Enquiry alerts (Nodemailer over SMTP) ─────────────────────────────────
# Any mailbox with SMTP access: a Gmail app password, or the hosting plan's
# mail server. ALERT_TO is the studio inbox that receives new enquiries.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM="LA Space Website <no-reply@laspaceinteriors.com>"
ALERT_TO=

# ── Media ────────────────────────────────────────────────────────────────
# local  = files under MEDIA_LOCAL_PATH, served by the API (dev only)
# s3     = any S3-compatible bucket behind a CDN (staging, production)
MEDIA_DRIVER=local
MEDIA_LOCAL_PATH=./storage
MEDIA_MAX_UPLOAD_MB=40
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=
